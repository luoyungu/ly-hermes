# Copy this file to .env for local development only.
# Never commit real API keys or access tokens.

# Optional: override Hermes runtime home.
# HERMES_HOME=/Users/you/.hermes

# Optional: override Hermes executable path.
# HERMES_BIN=/Users/you/.hermes/hermes-agent/venv/bin/hermes

# Optional: Windows Git Bash path when auto-detection fails.
# HERMES_GIT_BASH_PATH=C:\Program Files\Git\bin\bash.exe

# Model provider keys. Fill only the provider you use.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
GLM_API_KEY=
MOONSHOT_API_KEY=
YI_API_KEY=
MINIMAX_API_KEY=
SPARK_API_KEY=
SILICONFLOW_API_KEY=
QIANFAN_API_KEY=

# Optional OpenAI-compatible endpoint overrides.
OPENAI_BASE_URL=
CUSTOM_API_KEY=
CUSTOM_API_BASE_URL=

# Optional standalone web server settings.
LYHERMES_SERVER_DATA=
HERMES_SERVER_STANDALONE=
HERMES_API_HOST=127.0.0.1
HERMES_API_PORT=8644
PORT=8787
